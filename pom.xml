<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2236.v12dd4c483242</version>
    <relativePath />
  </parent>

  <groupId>io.jenkins.plugins</groupId>
  <artifactId>namespace-cloud</artifactId>
  <version>${changelist}</version>
  <packaging>hpi</packaging>

  <name>Namespace Cloud Agents</name>
  <description>Community plugin that provisions ephemeral Jenkins agents as Namespace micro-VM instances. Not affiliated with or endorsed by Namespace Labs.</description>

  <!-- Lives at starkware-libs while hosting is requested. If the Jenkins
       project accepts it, the repository moves to
       github.com/starkware-libs/namespace-cloud-plugin and these URLs change. -->
  <url>https://github.com/jenkinsci/${project.artifactId}-plugin</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/starkware-libs/namespace-cloud-plugin.git</connection>
    <developerConnection>scm:git:git@github.com:starkware-libs/namespace-cloud-plugin.git</developerConnection>
    <tag>${scmTag}</tag>
    <url>https://github.com/starkware-libs/namespace-cloud-plugin</url>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/starkware-libs/namespace-cloud-plugin/issues</url>
  </issueManagement>

  <properties>
    <!-- Continuous delivery: the real version is substituted by the
         incrementals build at release time. See
         https://www.jenkins.io/doc/developer/publishing/releasing-cd/ -->
    <changelist>999999-SNAPSHOT</changelist>
    <!-- Required by the Jenkins hosting checker: these gates catch accidental
         library bundling, redundant dependency overrides, and use of APIs that
         core already provides or has deprecated. -->
    <hpi.strictBundledArtifacts>true</hpi.strictBundledArtifacts>
    <!-- The Namespace API is gRPC, and core provides neither gRPC nor protobuf,
         so both are bundled along with their transitive dependencies. They are
         masked in maven-hpi-plugin configuration so they cannot resolve against
         another plugin's copy. Declared explicitly so that anything NEW showing
         up here fails the build rather than being bundled by accident. -->
    <hpi.bundledArtifacts>animal-sniffer-annotations,annotations,error_prone_annotations,failureaccess,grpc-api,grpc-context,grpc-core,grpc-netty-shaded,grpc-protobuf,grpc-protobuf-lite,grpc-stub,grpc-util,gson,guava,j2objc-annotations,listenablefuture,perfmark-api,proto-google-common-protos,protobuf-java</hpi.bundledArtifacts>
    <banObsoleteDependencyOverrides.skip>false</banObsoleteDependencyOverrides.skip>
    <ban-junit4-imports.skip>false</ban-junit4-imports.skip>
    <ban-deprecated-stapler.skip>false</ban-deprecated-stapler.skip>
    <ban-commons-lang-2.skip>false</ban-commons-lang-2.skip>
    <jenkins.baseline>2.541</jenkins.baseline>
    <jenkins.version>${jenkins.baseline}.3</jenkins.version>
    <grpc.version>1.84.0</grpc.version>
    <!-- Buf does not publish prebuilt Java SDKs for buf.build/namespace/cloud
         (the Maven registry 422s), so the stubs are generated at build time
         from the protos vendored under src/main/proto. See that dir's
         VENDORED.txt for the upstream commit. -->
    <protobuf.version>4.32.1</protobuf.version>
    <spotless.check.skip>false</spotless.check.skip>
    <!-- Overwritten by maven-release-plugin; needs a default for ordinary builds. -->
    <scmTag>HEAD</scmTag>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-${jenkins.baseline}.x</artifactId>
        <version>7002.v028a_3607ddc8</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.google.errorprone</groupId>
        <artifactId>error_prone_annotations</artifactId>
        <version>2.50.0</version>
      </dependency>
      <!-- grpc 1.84 pulls guava:33.6.0-android while the Jenkins BOM manages
           33.4.8-jre; pin one so requireUpperBoundDeps converges. -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>33.6.0-jre</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>${protobuf.version}</version>
    </dependency>

    <!-- Namespace API runtime. Stubs are generated from src/main/proto.
         netty-shaded avoids clashing with Jenkins remoting's Netty. -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jenkins.plugins</groupId>
      <artifactId>caffeine-api</artifactId>
    </dependency>
    <!-- Jenkins plugin dependencies -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>credentials</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>plain-credentials</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>ssh-credentials</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>ssh-slaves</artifactId>
    </dependency>
    <!-- Required on the compile path by protoc-generated gRPC stubs. -->
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
      <version>3.0.0</version>
      <scope>provided</scope>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-inprocess</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-testing</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <!-- Namespace's protos import themselves as "proto/namespace/...",
               so the import root is the dir containing "proto", not "proto". -->
          <protoSourceRoot>${project.basedir}/src/main/proto</protoSourceRoot>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
              <goal>compile-custom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jenkins-ci.tools</groupId>
        <artifactId>maven-hpi-plugin</artifactId>
        <configuration>
          <!-- gRPC/protobuf are bundled; mask them so they never resolve
               against another plugin's copy. -->
          <maskClasses>io.grpc. com.google.protobuf.</maskClasses>
        </configuration>
      </plugin>
    </plugins>
    <extensions>
      <!-- Resolves ${os.detected.classifier} for the protoc binaries. -->
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>1.7.1</version>
      </extension>
    </extensions>
  </build>
</project>
