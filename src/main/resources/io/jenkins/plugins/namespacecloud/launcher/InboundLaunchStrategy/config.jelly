<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">

  <f:entry title="${%Agent image}" field="image"
           description="${%Container image running the Jenkins inbound agent. Match its JDK to the controller's Java version.}">
    <f:combobox default="jenkins/inbound-agent:latest-jdk21"/>
  </f:entry>

  <f:entry field="webSocket" title="${%Connect over WebSocket}">
    <f:checkbox default="true"/>
  </f:entry>

  <f:entry field="exposeDockerSocket" title="${%Expose the instance Docker socket to the agent}">
    <f:checkbox/>
  </f:entry>

</j:jelly>
